{
  "name": "@kept-hq/widget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Embeddable post-purchase support chat widget for the Kept agent service.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "pnpm run build && node build.mjs --serve",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "esbuild": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
