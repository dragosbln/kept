{
  "name": "kept",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source, self-hostable post-purchase support agent for e-commerce, with the trust layer as the product.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @kept-hq/agent dev",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v",
    "stack:logs": "docker compose logs -f",
    "stack:ps": "docker compose ps"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
