{
  "name": "kept",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source, self-hostable post-purchase support agent for e-commerce, with the trust layer as the product.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "check:boundaries": "node scripts/check-eval-boundary.mjs",
    "check": "pnpm check:boundaries && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "demo:trace": "tsx --env-file-if-exists=.env scripts/trace-demo.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "pnpm --filter @kept-hq/agent dev",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v",
    "stack:logs": "docker compose logs -f",
    "stack:ps": "docker compose ps"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
